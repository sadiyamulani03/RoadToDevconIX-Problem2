# ---------------------------------------------------------------------------
# Headline to Market - environment example
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- LLM provider (OpenAI-compatible API) ----------------------------------
# Leave LLM_API_KEY empty to run in the clearly-labelled heuristic fallback
# mode (no network calls, no API key required).
LLM_API_KEY=
# Base URL of any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, ...).
LLM_BASE_URL=https://api.openai.com/v1
# Model name served by the endpoint above.
LLM_MODEL=gpt-4o-mini
# "auto" honours LLM_API_KEY; "heuristic" forces the offline fallback.
LLM_PROVIDER=auto
# Structured-output mode: "json_schema" | "json_object" | "none".
LLM_STRUCTURED_OUTPUT=json_schema
# Hard timeout (ms) enforced on every single model HTTP request.
LLM_TIMEOUT_MS=30000
# Total attempts per model request: 1 initial call + (n - 1) retries. Max 5.
LLM_MAX_ATTEMPTS=3

# --- Storage ----------------------------------------------------------------
# SQLite file used for market drafts. Directory must be writable.
DATABASE_PATH=./.data/markets.db

# --- Editor access (optional) ----------------------------------------------
# If set, all mutating API endpoints require an `x-editor-token` header equal
# to this value. Leave empty for the documented local-demo access model.
EDITOR_ACCESS_TOKEN=
